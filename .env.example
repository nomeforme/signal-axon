# Signal CLI Configuration
SIGNAL_CLI_WS_URL=ws://signal-cli:8080/v1/receive
SIGNAL_CLI_API_URL=http://signal-cli:8080

# Bot phone numbers (comma-separated, must match config.json order)
BOT_PHONE_NUMBERS=+12223334444,+15556667777

# Connectome gRPC Server
CONNECTOME_GRPC_HOST=connectome:50051

# LLM Provider - Anthropic API (for non-Bedrock models)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# LLM Provider - AWS Bedrock (for bedrock- prefixed models)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
