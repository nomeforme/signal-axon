{
  "name": "signal-axon",
  "version": "0.1.0",
  "description": "Signal messenger AXON module for Connectome - bridges Signal CLI REST API to Connectome events and facets",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/grpc-main.ts",
    "start:dev": "nodemon --watch src --exec tsx src/grpc-main.ts",
    "start:axon": "tsx src/axon-main.ts"
  },
  "keywords": [
    "connectome",
    "axon",
    "signal",
    "signal-messenger",
    "chat",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@connectome/axon-interfaces": "file:../connectome-axon-interfaces",
    "@connectome/axon-server": "file:../axon-server",
    "@connectome/grpc": "file:../connectome-grpc",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.0",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.3.0"
  }
}
