{
  "name": "@connectome/signal-axon",
  "version": "0.1.0",
  "description": "Signal messenger AXON module for Connectome - bridges Signal CLI REST API to Connectome events and facets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "start": "tsx src/grpc-main.ts",
    "start:dev": "nodemon --watch src --exec tsx src/grpc-main.ts",
    "start:axon": "tsx src/axon-main.ts"
  },
  "keywords": [
    "connectome",
    "axon",
    "signal",
    "signal-messenger",
    "chat",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@connectome/axon-interfaces": "workspace:*",
    "@connectome/axon-server": "workspace:*",
    "@connectome/grpc-common": "workspace:*",
    "@connectome/axon-binding": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.3.0"
  }
}
